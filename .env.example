BOT_TOKEN=your_bot_token_from_botfather
OPENROUTER_API_KEY=your_openrouter_api_key
# необязательно: любая модель из каталога OpenRouter
MODEL=meta-llama/llama-3.1-8b-instruct
# доступ: username через запятую (без @), по умолчанию sijin34
ALLOWED_USERNAMES=sijin34
# доступ: числовые Telegram ID через запятую (надёжнее username)
ALLOWED_USER_IDS=
