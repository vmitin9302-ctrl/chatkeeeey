BOT_TOKEN=your_bot_token_from_botfather
OPENROUTER_API_KEY=your_openrouter_api_key
# необязательно: любая модель из каталога OpenRouter
MODEL=meta-llama/llama-3.1-8b-instruct
# доступ: числовые Telegram ID через запятую (например 123456789,987654321)
ALLOWED_USER_IDS=
# необязательно: username через запятую без @
ALLOWED_USERNAMES=
